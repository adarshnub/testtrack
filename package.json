{
  "name": "bankledger-pro",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": ["apps/web"],
  "engines": {"node": ">=22.0.0"},
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm --filter @bankledger/web dev",
    "build": "pnpm --filter @bankledger/web build",
    "start": "pnpm --filter @bankledger/web start",
    "lint": "pnpm --filter @bankledger/web lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env apps/web/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/workflow.integration.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "tsx": "4.21.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
